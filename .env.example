# --- AWS credentials (required) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2

# --- Chatbot settings (optional — these are the defaults) ---
MODEL_ID=global.amazon.nova-2-lite-v1:0
MAX_TOKENS=300
TEMPERATURE=0.7
MAX_TURNS=3

# Prices in USD per 1M tokens for MODEL_ID — update if you change the model
# See aws.amazon.com/bedrock/pricing
INPUT_PRICE_PER_M=0.30
OUTPUT_PRICE_PER_M=2.50

# --- Document search (optional — these are the defaults, chosen by evals/RESULTS.md) ---
MAX_CHUNK_WORDS=100
TOP_K=5
SEARCH_MODE=hybrid

# --- Public demo protections (optional) ---
APP_PASSWORD=
MAX_QUESTIONS_PER_SESSION=20
MAX_QUESTION_CHARS=500
